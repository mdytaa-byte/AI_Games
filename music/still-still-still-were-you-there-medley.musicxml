<score-partwise version="4.0">
  <work>
    <work-title>Still, Still, Still / Were You There</work-title>
  </work>
  <movement-title>A Medley for SATB Choir and Piano</movement-title>
  <identification>
    <creator type="composer">Traditional Austrian carol and African American spiritual</creator>
    <creator type="arranger">Original SATB and piano medley arrangement</creator>
    <rights>Tunes and traditional English texts are in the public domain. Still, Still, Still: Austrian carol, Salzburgische Volkslieder, 1865; public-domain English translation. Were You There: African American spiritual, 19th century (text as commonly sung, including the Resurrection stanza). This choral-piano arrangement is original and is not the 2025 Hymns for Home and Church setting. Intended for church and home use.</rights>
    <encoding>
      <software>Custom MusicXML generator</software>
      <encoding-date>2026-08-22</encoding-date>
      <supports element="accidental" type="yes"/>
      <supports element="beam" type="yes"/>
      <supports attribute="new-system" element="print" type="yes" value="yes"/>
    </encoding>
  </identification>
  <credit page="1">
    <credit-type>title</credit-type>
    <credit-words font-size="22" justify="center" valign="top" default-y="1450">Still, Still, Still / Were You There</credit-words>
  </credit>
  <credit page="1">
    <credit-type>subtitle</credit-type>
    <credit-words font-size="12" font-style="italic" justify="center" default-y="1380">A medley for SATB choir and piano</credit-words>
  </credit>
  <credit page="1">
    <credit-type>composer</credit-type>
    <credit-words font-size="10" justify="right" default-y="1320" default-x="1100">Traditional  ·  arr. for church choir</credit-words>
  </credit>
  <credit page="1">
    <credit-type>rights</credit-type>
    <credit-words default-y="50" font-size="8" justify="center">Voicings: A piano intro · B Still v.1 SA · C Still v.2 SATB · D hum transition · E Were You There (crucified) TB + SA hum · F (tomb) SA + TB hum · G (rose) SATB · H coda. Keep the piano flowing; do not play block chords. The “sun refused to shine” stanza may replace letter F.</credit-words>
  </credit>
